PORT=5000
HOST=127.0.0.1
NODE_ENV=production

# MongoDB Atlas (allow this server's IP in Atlas > Network Access)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/vibeapp?retryWrites=true&w=majority

JWT_SECRET=CHANGE_ME_long_random_string
GROQ_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# Frontend (CORS) and public URLs of THIS backend
FRONTEND_URL=https://vibe-app-dun.vercel.app
PUBLIC_BACKEND_URL=https://api.YOURDOMAIN
APK_PUBLIC_BASE_URL=https://api.YOURDOMAIN
MOBILE_PREVIEW_BASE_URL=https://api.YOURDOMAIN

# Build toolchain (replace 'ubuntu' with your Linux username; DigitalOcean default is 'root' -> use a normal user)
FLUTTER_PATH=/home/ubuntu/flutter
APK_FLUTTER_PATH_WSL=/home/ubuntu/flutter/bin/flutter
ANDROID_SDK_PATH=/home/ubuntu/android-sdk
JAVA_HOME_WSL=/usr/lib/jvm/java-17-openjdk-amd64

# Keep builds one at a time on a 4GB server
WEB_PREVIEW_CONCURRENCY=1
APK_BUILD_CONCURRENCY=1
APK_BUILD_TIMEOUT_MS=1800000
WEB_PREVIEW_BUILD_TIMEOUT_MS=900000
